root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

[*.{py,pyi}]
indent_size = 4
max_line_length = 88

[*.{js,jsx,ts,tsx,json,yaml,yml,css,scss,md}]
indent_size = 2

[Makefile]
indent_style = tab

[*.sql]
indent_size = 4

[Dockerfile]
indent_size = 4
