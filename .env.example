# =============================================================================
# SIH26162 - AI-Based Detection and Classification of Industrial Fires
#            and Persistent Thermal Sources
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://sih_user:sih_password@localhost:5432/sih_thermal
DATABASE_URL_SYNC=postgresql://sih_user:sih_password@localhost:5432/sih_thermal

# --- NASA FIRMS API ---
FIRMS_API_KEY=your_firms_api_key_here
FIRMS_MAP_KEY=your_firms_map_key_here

# --- FastAPI Backend ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Next.js Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Supabase (optional managed backend) ---
# Personal Access Token (PAT) for Supabase CLI / Management API / CI.
# SERVER-ONLY — do not prefix with NEXT_PUBLIC_. Get one at:
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your_supabase_pat_here
# Public client connection (safe to expose to the browser) — required for the
# app to talk to Supabase directly:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service-role key (SERVER-ONLY, secret) — for privileged server-side operations:
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
