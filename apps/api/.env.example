# =============================================================================
# SIH26162 Thermal Intelligence API — environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit a real `.env`
# (it is already in .gitignore). The service reads every value below through
# `app.core.config.Settings`, so the variable NAME is the setting name verbatim
# — there is no mapping table. The defaults shown here are what the service
# falls back to when a variable is absent.
#
# Naming rule: `DATABASE_URL` in this file => `settings.DATABASE_URL`. Done.
# =============================================================================

# --- Service identity -------------------------------------------------------
APP_NAME=SIH26162 Thermal Intelligence API
APP_VERSION=0.1.0
# One of: development | test | staging | production
ENVIRONMENT=development
DEBUG=false

# --- HTTP server ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Set true when running behind nginx / an ALB so X-Forwarded-* is trusted.
TRUST_PROXY_HEADERS=false

# --- Database ---------------------------------------------------------------
# Async driver used by the app.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sih26162_thermal
# Sync driver used by Alembic (Alembic cannot drive asyncpg).
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/sih26162_thermal
#
# --- Supabase backend option (no Render billing card required) ---
# PostGIS is already enabled on project "sih26162-thermal" (ref smaligmdpqgdzugidiwk).
# Copy the URI from Supabase Dashboard > Settings > Database > Connection string, then:
#   DATABASE_URL=postgresql+asyncpg://postgres:<PASSWORD>@db.smaligmdpqgdzugidiwk.supabase.co:5432/postgres
#   DATABASE_URL_SYNC=postgresql://postgres:<PASSWORD>@db.smaligmdpqgdzugidiwk.supabase.co:5432/postgres
# (Use 6543 + user `postgres.smaligmdpqgdzugidiwk` only if you deliberately want the pooler.)
SQL_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30

# --- External integrations -------------------------------------------------
# NASA FIRMS API key + endpoint (active-fire detection feed).
FIRMS_API_KEY=
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/area/json
FIRMS_MAP_KEY=
FIRMS_TIMEOUT_SECONDS=30

# Mock / placeholder ML service. The shipped classifier is deterministic but
# NOT a trained model — see app/services/classification_service.py.
ML_SERVICE_URL=http://localhost:8001
ML_TIMEOUT_SECONDS=30
# When true, an ML failure degrades to "unclassified" instead of 500-ing.
# Off in production so we notice the model broke.
ML_FAIL_OPEN=true

# --- CORS -------------------------------------------------------------------
# Comma-separated list (or a JSON array). Browsers hitting the live API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# --- Pagination -------------------------------------------------------------
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100

# --- Geospatial -------------------------------------------------------------
# SRID for geometry columns (4326 = WGS84, the standard lat/lon).
GEOMETRY_SRID=4326

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# One of: console | json
LOG_FORMAT=console
LOG_COLOUR=true

# --- Request limits ---------------------------------------------------------
# Max request body in bytes (0 disables). This is a read-only API today.
MAX_BODY_BYTES=1048576
REQUEST_TIMEOUT_SECONDS=30
